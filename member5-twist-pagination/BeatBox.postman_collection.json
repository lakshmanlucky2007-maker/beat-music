  "item": [
    {
      "name": "1. Twist - Pages of results",
      "item": [
        {
          "name": "Test 1: page=1&limit=2 -> 200, 2 instruments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has total, page and data\", () => { pm.expect(b).to.have.property(\"total\"); pm.expect(b.page).to.eql(1); });",
                  "pm.test(\"Returns 2 instruments\", () => pm.expect(b.data.length).to.eql(2));",
                  "pm.collectionVariables.set(\"page1Ids\", JSON.stringify(b.data.map(i => i.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Test 2: page=2&limit=2 -> 200, the next 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Page is 2 with 2 instruments\", () => { pm.expect(b.page).to.eql(2); pm.expect(b.data.length).to.eql(2); });",
                  "const prev = JSON.parse(pm.collectionVariables.get(\"page1Ids\") || \"[]\");",
                  "pm.test(\"Different from page 1\", () => b.data.forEach(i => pm.expect(prev).to.not.include(i.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?page=2&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Test 3: page=0 -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
