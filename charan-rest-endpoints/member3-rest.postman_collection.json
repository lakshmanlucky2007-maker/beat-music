{
  "info": {
    "name": "Member 3 - REST endpoints",
    "description": "CRUD for instruments and the join endpoint. Start the server on a fresh database (delete beatbox.db) before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get all instruments -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        }
      }
    },
    {
      "name": "Add instrument -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sitar\",\n  \"family\": \"strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get one instrument -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Update instrument -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated\", () => { const b = pm.response.json(); pm.expect(b.name).to.eql('Electric Sitar'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electric Sitar\",\n  \"family\": \"strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete instrument -> 204",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Get deleted -> 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Delete instrument with loans -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "1"
          ]
        }
      }
    },
    {
      "name": "JOIN: loans with names -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Each loan has musician_name and instrument_name\", () => { const b = pm.response.json(); b.forEach(l => { pm.expect(l).to.have.property('musician_name'); pm.expect(l).to.have.property('instrument_name'); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans"
          ]
        }
      }
    },
    {
      "name": "Borrow Flute -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"loanId\", pm.response.json().id);",
              "pm.test(\"Shows names\", () => { const b = pm.response.json(); pm.expect(b.instrument_name).to.eql('Flute'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"musician_id\": 2,\n  \"instrument_id\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Borrow Flute again -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"musician_id\": 1,\n  \"instrument_id\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Return Flute -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has return date\", () => { const b = pm.response.json(); pm.expect(b.return_date).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/loans/{{loanId}}/return",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans",
            "{{loanId}}",
            "return"
          ]
        }
      }
    },
    {
      "name": "Add musician -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/musicians",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "musicians"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Divya Nair\",\n  \"class_name\": \"9A\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}