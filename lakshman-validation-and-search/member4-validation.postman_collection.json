{
  "info": {
    "name": "Member 4 - Validation and search",
    "description": "Input checks, error messages and search. Start the server on a fresh database (delete beatbox.db) before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Add with empty name -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"family\": \"strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Add with wrong family -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electric Guitar\",\n  \"family\": \"rock\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Add with nothing -> 400 (both errors)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Mentions name and family\", () => { const b = pm.response.json(); pm.expect(b.error).to.include('name').and.include('family'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update missing family -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "2"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cello\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Valid add (trim + lowercase) -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Saved cleanly\", () => { const b = pm.response.json(); pm.expect(b.name).to.eql('Sitar'); pm.expect(b.family).to.eql('strings'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"  Sitar \",\n  \"family\": \"Strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Bad id -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "abc"
          ]
        }
      }
    },
    {
      "name": "Search family=strings -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only strings\", () => { const b = pm.response.json(); pm.expect(b.length).to.be.above(0); b.forEach(i => pm.expect(i.family).to.eql('strings')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments?family=strings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ],
          "query": [
            {
              "key": "family",
              "value": "strings"
            }
          ]
        }
      }
    },
    {
      "name": "Search family=Percussion (any case) -> 200",
      "event": [
