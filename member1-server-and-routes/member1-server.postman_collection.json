{
  "info": {
    "name": "Member 1 - Server and routes",
    "description": "Routes and status codes. Start the server on a fresh database (delete beatbox.db) before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Home -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lists endpoints\", () => { const b = pm.response.json(); pm.expect(b.endpoints).to.include('/instruments'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "All musicians -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Is a list\", () => { const b = pm.response.json(); pm.expect(b).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/musicians",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "musicians"
          ]
        }
      }
    },
    {
      "name": "All instruments -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        }
      }
    },
    {
      "name": "One instrument -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Id is 1\", () => { const b = pm.response.json(); pm.expect(b.id).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "1"
          ]
        }
      }
    },
    {
      "name": "Missing instrument -> 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/99",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "99"
          ]
        }
      }
    },
    {
      "name": "Add instrument -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sitar\",\n  \"family\": \"strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update instrument -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Name changed\", () => { const b = pm.response.json(); pm.expect(b.name).to.eql('Electric Sitar'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electric Sitar\",\n  \"family\": \"strings\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete instrument -> 204",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "All loans -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans"
          ]
        }
      }
    },
    {
      "name": "Add loan -> 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"musician_id\": 2,\n  \"instrument_id\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Unknown route -> 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/drums",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "drums"
          ]
        }
      }
    },
    {
      "name": "Broken JSON -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Has a clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/instruments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "instruments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Sitar\",",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}